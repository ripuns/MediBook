DATABASE_URL=postgresql://user:password@host/dbname
JWT_ACCESS_SECRET=your_random_64_char_secret_here
JWT_REFRESH_SECRET=your_different_random_64_char_secret_here
PORT=5000
NODE_ENV=development

# Email — use Gmail App Password, not your real Gmail password
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# LLM — get from Google AI Studio / Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Google Calendar OAuth — get from console.cloud.google.com
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback

# Frontend origin — used for CORS and post-OAuth redirects
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
